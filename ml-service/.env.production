# ML Service Production Configuration
# Copy this to .env and update with your production values

# Service Configuration
ML_SERVICE_PORT=5000
ML_SERVICE_HOST=0.0.0.0

# Model Configuration
MODEL_PATH=app/models/phishing_detector.pkl
MODEL_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO

# CORS Origins (update with your backend URL)
ALLOWED_ORIGINS=https://catchers-ai-backend.onrender.com,https://catchers-ai-frontend.vercel.app
